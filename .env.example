# Modèle de .env pour compose.prod.yaml (prod) ET compose.staging.yaml (staging).
# Un .env DIFFÉRENT par environnement, jamais dans Git :
#   cp .env.example ~/taskflow-prod/.env      && chmod 600 ~/taskflow-prod/.env
#   cp .env.example ~/taskflow-staging/.env   && chmod 600 ~/taskflow-staging/.env
# (compose.yaml, le dev, fonctionne sans .env grâce à ses valeurs par défaut.)
#
# Règle : un secret différent par environnement. Une fuite du staging ne doit
# jamais ouvrir la prod.

# --- Base de données ---------------------------------------------------------
# Mot de passe long et aléatoire : openssl rand -hex 24 (hexadécimal = aucun
# caractère qui casserait l'URL ci-dessous). Il apparaît DEUX fois.
POSTGRES_PASSWORD=changez-moi
DATABASE_URL=postgres://taskflow:changez-moi@db:5432/taskflow

# --- API ---------------------------------------------------------------------
# production dans ~/taskflow-prod, staging dans ~/taskflow-staging
APP_ENV=production

# --- Images ------------------------------------------------------------------
# Propriétaire GitHub des images ghcr.io, EN MINUSCULES.
GHCR_OWNER=votre-compte-github
# Version lancée : deploy.sh la fournit lui-même à chaque déploiement.
IMAGE_TAG=latest

# --- Ports -------------------------------------------------------------------
# Prod (proxy) : 80/443 par défaut ; si pris ou Docker rootless : 8082 et 8443.
HTTP_PORT=80
HTTPS_PORT=443
# Staging (front publié directement, sans proxy) : 8081.
FRONT_PORT=8081
